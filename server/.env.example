# NJ Transit Rail Data API (from developer.njtransit.com)
# Get token with these; do not commit real values to git.
NJTRANSIT_USERNAME=your_username
NJTRANSIT_PASSWORD=your_password

# Optional: use test environment instead of production
# NJTRANSIT_USE_TEST=true

# Optional: server port (default 3000)
# PORT=3000
